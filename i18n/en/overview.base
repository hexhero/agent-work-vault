filters:
  and:
    - file.ext == "md"
views:
  - type: table
    name: Projects
    filters:
      and:
        - type == "project"
    order:
      - file.name
      - description
      - aliases
      - repo
      - hosts
      - file.backlinks
  - type: table
    name: Task details
    filters:
      and:
        - type == "task-doc"
    order:
      - file.name
      - project
      - log
  - type: table
    name: Research
    filters:
      and:
        - type == "research"
    order:
      - file.name
      - topic
      - aliases
      - updated
  - type: table
    name: Guides
    filters:
      and:
        - type == "guide"
    order:
      - file.name
      - topic
      - aliases
      - updated
